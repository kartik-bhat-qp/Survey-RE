#!/usr/bin/env bash
# pre-push: log a high-level summary of commits about to be pushed.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
range=""

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -z "${local_sha:-}" || "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ -n "${remote_sha:-}" && ! "$remote_sha" =~ ^0+$ ]]; then
    range="${remote_sha}..${local_sha}"
  else
    range="$local_sha"
  fi
done

if [[ -n "$range" ]]; then
  node "$root/scripts/record-git-activity.cjs" --action push --range "$range" || true
else
  node "$root/scripts/record-git-activity.cjs" --action push || true
fi

exit 0
